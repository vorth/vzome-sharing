Red struts also come in three sizes, with golden ratio scaling.      </content>
    </page>
    <page title="long reds" snapshot="14">
      <ViewModel distance="73.2242431640625" far="146.448486328125" near="0.06780022382736206" parallel="false" stereoAngle="0.0" width="32.95090866088867">
        <LookAtPoint x="2.8794875144958496" y="4.69978666305542" z="4.659108638763428"/>
        <UpDirection x="0" y="1" z="0"/>
        <LookDirection x="0.8506507873535156" y="0" z="-0.525731086730957"/>
      </ViewModel>
      <content xml:space="preserve">
Older Zometool sets included R3 struts but no R0 struts.      </content>
    </page>
    <page title="yellow lengths" snapshot="15">
      <ViewModel distance="50.12782669067383" far="100.25565338134766" near="0.046414654701948166" parallel="false" stereoAngle="0.0" width="22.55752182006836">

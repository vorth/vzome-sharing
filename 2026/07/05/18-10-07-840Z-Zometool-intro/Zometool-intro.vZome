        <LookDirection x="0.35682210326194763" y="0" z="0.9341723322868347"/>
      </ViewModel>
      <content xml:space="preserve">
Yellow struts also come in three sizes, with golden ratio scaling.      </content>
    </page>
    <page title="long yellows" snapshot="16">
      <ViewModel distance="69.69206237792969" far="139.38412475585938" near="0.06452968716621399" parallel="false" stereoAngle="0.0" width="31.361427307128906">

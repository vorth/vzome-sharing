        <LookDirection x="0" y="0" z="1"/>
      </ViewModel>
      <content xml:space="preserve">
Older Zometool sets were one scale larger overall, including B3 struts but no B0 struts.      </content>
    </page>
    <page title="red lengths" snapshot="13">
      <ViewModel distance="56.01185989379883" far="112.02371978759766" near="0.05186283215880394" parallel="false" stereoAngle="0.0" width="25.205337524414062">
